OPENAI_API_KEY=
VOICE_DISABLED=0
# Safety approval reviewer for bash/edit/write (cheap model; 1 disables)
WILEY_APPROVAL_MODEL=gpt-5.4-mini
WILEY_APPROVAL_DISABLED=0

# Wiley Cloud is configured in Settings, not here: the relay base URL lives in
# settings.json and the session token in the secret store, so there is no
# WILEY_RELAY_BASE_URL to set. See relay/README.md for running one locally.

# Optional. The workspace the agent may edit and the SQLite ledger directory.
# Unset means ~/Wiley in the packaged app, the launch directory from a
# checkout, and whatever Settings > Workspace says in either.
# WILEY_PROJECT_DIR=
# WILEY_DATA_DIR=

# --- Packaging -------------------------------------------------------------
# `npm run package:mac` signs with the Developer ID identity in your login
# keychain and produces a DMG that still shows Gatekeeper's warning on another
# machine. `npm run package:mac:unsigned` skips signing entirely.
#
# `npm run package:mac:notarized` also submits to Apple. Notarization
# credentials are NEVER read from this file; export them in the shell that
# runs the build, either as a stored keychain profile:
#
#   xcrun notarytool store-credentials wiley-notary \
#     --apple-id you@example.com --team-id 9D7HJAGQ8L \
#     --password <app-specific-password>
#   export APPLE_KEYCHAIN_PROFILE=wiley-notary
#
# or as the three variables directly:
#
#   export APPLE_ID=you@example.com
#   export APPLE_APP_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop
#   export APPLE_TEAM_ID=9D7HJAGQ8L
