OPENAI_API_KEY=
VOICE_DISABLED=0
# Safety approval reviewer for bash/edit/write (cheap model; 1 disables)
WILEY_APPROVAL_MODEL=gpt-5.4-mini
WILEY_APPROVAL_DISABLED=0

# Wiley Cloud is configured in Settings, not here: the relay base URL lives in
# settings.json and the session token in the secret store, so there is no
# WILEY_RELAY_BASE_URL to set. See relay/README.md for running one locally.
