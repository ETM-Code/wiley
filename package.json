{
  "name": "wiley",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Wiley: a co-present voice-driven whiteboard where a Pi agent sketches and builds alongside you.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "concurrently --kill-others --names backend,web \"tsx watch src/server/index.ts\" \"vite --config vite.browser.config.ts\"",
    "dev:web:backend": "tsx watch src/server/index.ts",
    "dev:web:frontend": "vite --config vite.browser.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:landing": "node scripts/e2e-landing-page.mjs",
    "test:e2e:interactive": "node scripts/e2e-interactive.mjs",
    "test:e2e:worker": "node scripts/e2e-worker.mjs",
    "start": "electron-vite preview",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64",
    "package:mac:notarized": "npm run build && WILEY_NOTARIZE=1 electron-builder --mac dmg --arm64 -c.mac.notarize=true",
    "package:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64",
    "icon": "bash scripts/make-icon.sh",
    "sync:skill": "tsx scripts/sync-skill.ts",
    "relay:test": "npm --prefix relay test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@excalidraw/excalidraw": "0.18.1",
    "dotenv": "^17.4.2",
    "elkjs": "0.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "^10.0.3",
    "electron": "43.1.1",
    "electron-builder": "26.8.1",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.1",
    "fontkit": "^2.0.4",
    "globals": "^17.11.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.1",
    "vitest": "4.1.0"
  },
  "build": {
    "appId": "ai.eltrus.wiley",
    "productName": "Wiley",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".pi/skills",
        "to": "skills",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.wasm",
      "**/node_modules/@silvia-odwyer/photon-node/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": "EOGHAN TIMOTHY COLLINS (9D7HJAGQ8L)",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wiley listens so you can talk through what to draw and build.",
        "LSMinimumSystemVersion": "12.0"
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
